{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "command": "next dev -H 0.0.0.0",
      "options": {
        "cwd": "apps/web"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/web"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/web"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "apps/web"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "apps/web"
      }
    },
    "generate:api": {
      "command": "orval --config orval.config.ts",
      "options": {
        "cwd": "apps/web"
      }
    }
  }
}
