# Backend origin, server-side only. The browser never calls the backend
# directly — requests go through the same-origin proxy at /api/v1/*, which
# attaches the HTTP-only access token. Do not expose this as NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:8000

# Source of truth for `pnpm generate:api`. Falls back to ./openapi.json.
OPENAPI_URL=http://127.0.0.1:8000/openapi.json
